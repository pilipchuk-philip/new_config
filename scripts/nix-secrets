#!/bin/sh
set -eu
umask 077

fail() {
  echo "$*" >&2
  exit 1
}

usage() {
  echo 'Usage: nix-secrets init | encrypt INPUT OUTPUT | decrypt INPUT OUTPUT | save NAME FILE | restore NAME FILE' >&2
  exit 1
}

[ "$#" -ge 1 ] || usage
action="$1"
shift
key_dir="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age"
key_file="$key_dir/keys.txt.age"
work=''
cleanup() {
  if [ -n "$work" ]; then rm -rf -- "$work"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

case "$action" in
  init)
    [ "$#" -eq 0 ] || usage
    repo="$(nix-repo)"
    [ ! -e "$key_file" ] && [ ! -L "$key_file" ] || fail "Ключ уже существует: $key_file"
    [ ! -e "$repo/.sops.yaml" ] && [ ! -L "$repo/.sops.yaml" ] || fail 'Файл .sops.yaml уже существует.'
    mkdir -p -- "$key_dir"
    chmod 700 -- "$key_dir"
    work="$(mktemp -d "$key_dir/.nix-secrets.XXXXXX")"
    age-keygen -o "$work/key"
    recipient="$(age-keygen -y "$work/key")"
    age --passphrase -o "$work/key.age" "$work/key"
    printf 'creation_rules:\n  - path_regex: '\''.*\\.enc\\.json$'\''\n    age: %s\n' "$recipient" > "$work/config"
    ln -- "$work/key.age" "$key_file"
    # The configuration contains only the public recipient.
    (set -C; cat "$work/config" > "$repo/.sops.yaml")
    echo "Созданы $key_file и $repo/.sops.yaml. Сохраните резервную копию зашифрованного ключа отдельно."
    exit 0
    ;;
  encrypt | decrypt | save | restore)
    [ "$#" -eq 2 ] || usage
    ;;
  *) usage ;;
esac

case "$action" in
  save | restore)
    name="$1"
    case "$name" in '' | . | .. | *[!a-zA-Z0-9._-]*) fail 'NAME может содержать только буквы, цифры, точку, дефис и подчёркивание.' ;; esac
    repo="$(nix-repo)"
    mkdir -p -- "$repo/secrets"
    if [ "$action" = save ]; then
      input="$2"
      output="$repo/secrets/$name.enc.json"
      action=encrypt
    else
      input="$repo/secrets/$name.enc.json"
      output="$2"
    fi
    ;;
  *) input="$1"; output="$2" ;;
esac

# Prefix relative paths so filenames beginning with '-' are never options.
case "$input" in /*) ;; *) input="./$input" ;; esac
case "$output" in /*) ;; *) output="./$output" ;; esac
[ -f "$input" ] && [ -r "$input" ] || fail "Не удаётся прочитать файл: $input"
if [ "$action" != restore ]; then
  [ ! -e "$output" ] && [ ! -L "$output" ] || fail "Файл уже существует: $output"
fi
[ -f "$key_file" ] || fail 'Сначала выполните nix-secrets init или восстановите свой keys.txt.age.'

if [ "$action" = restore ]; then
  work="$(mktemp -d "${TMPDIR:-/tmp}/nix-secrets.XXXXXX")"
else
  work="$(mktemp -d "$(dirname -- "$output")/.nix-secrets.XXXXXX")"
fi
age --decrypt -o "$work/key" "$key_file"
if [ "$action" = encrypt ]; then
  repo="$(nix-repo)"
  sops --encrypt --config "$repo/.sops.yaml" --filename-override "$output" \
    --input-type binary --output-type json "$input" > "$work/result"
else
  SOPS_AGE_KEY_FILE="$work/key" sops --decrypt --input-type json --output-type binary "$input" > "$work/result"
fi
chmod 600 -- "$work/result"

if [ "$action" = restore ]; then
  [ ! -L "$output" ] || fail "Назначение является символической ссылкой: $output"
  privileged=0
  if [ "$output" = /etc/hosts ]; then privileged=1; fi
  if [ -e "$output" ]; then
    [ -f "$output" ] || fail "Назначение не является обычным файлом: $output"
    if [ "$privileged" -eq 1 ]; then
      diff -u -- "$output" "$work/result" || [ "$?" -eq 1 ]
    fi
    printf 'Заменить %s? [yes/no] ' "$output" > /dev/tty
    read -r answer < /dev/tty
    [ "$answer" = yes ] || fail 'Восстановление отменено.'
    backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/nix-secrets/backups"
    mkdir -p -- "$backup_dir"
    chmod 700 -- "$backup_dir"
    backup="$(mktemp "$backup_dir/$name.XXXXXX.dec")"
    if [ "$privileged" -eq 1 ]; then
      # The backup intentionally belongs to the current user, not root.
      # shellcheck disable=SC2024
      sudo cat -- "$output" > "$backup"
    else
      cat -- "$output" > "$backup"
    fi
    echo "Резервная копия: $backup"
  fi
  if [ "$privileged" -eq 1 ]; then
    sudo install -m 644 -- "$work/result" "$output"
  else
    mkdir -p -- "$(dirname -- "$output")"
    case "$output" in "$HOME/.ssh/"*) chmod 700 -- "$HOME/.ssh" ;; esac
    install -m 600 -- "$work/result" "$output"
  fi
else
  # Publish without overwriting an existing file, including in a race.
  ln -- "$work/result" "$output"
fi
echo "Готово: $output"
