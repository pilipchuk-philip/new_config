#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
  echo "Usage: nix-check"
  exit 1
fi

unset CDPATH
repo_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"

echo "#########################################################################"
echo "#   Nix Check"
echo "#   Repo: ${repo_dir}"

cd "${repo_dir}"

echo "#########################################################################"
echo "#   Flake"
nix flake check --all-systems --no-build --no-write-lock-file

echo "#########################################################################"
echo "#   Git Whitespace"
git diff --check

echo "#########################################################################"
echo "#   Stale Host Flake References"
if rg -n 'hosts/(mac|nixos|ubuntu)|/hosts/mac|--flake[[:space:]]+.*hosts|new_config/hosts' README.md AGENTS.md scripts flake.nix --glob '!scripts/nix-check'; then
  echo "Found stale hosts/ flake references"
  exit 1
fi

echo "#########################################################################"
echo "#   Nix Check Complete"
