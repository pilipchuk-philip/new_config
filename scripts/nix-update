#!/bin/sh
set -eu

dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "Usage: nix-update [--dry-run]"
  exit 1
fi

run() {
  if [ "$dry_run" -eq 1 ]; then
    echo "+ $*"
  else
    "$@"
  fi
}

unset CDPATH
repo_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"
flake_ref=""
current_user="$(id -un)"

case "$(uname -s)" in
  Linux)
    flake_ref="${repo_dir}#nixos"
    rebuild_cmd="nixos-rebuild"
    ;;
  Darwin)
    rebuild_cmd="darwin-rebuild"
    case "$current_user" in
      q)
        flake_ref="${repo_dir}#mac"
        ;;
      ppy)
        flake_ref="${repo_dir}#mac-work"
        ;;
      *)
        echo "Unsupported Darwin user: ${current_user}"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Unsupported OS: $(uname -s)"
    exit 1
    ;;
esac

echo "#########################################################################"
echo "#   Nix Update"
echo "#   Repo: ${repo_dir}"
echo "#   User: ${current_user}"
echo "#   Flake: ${flake_ref}"

cd "${repo_dir}"
run nix flake update

if ! command -v "${rebuild_cmd}" >/dev/null 2>&1; then
  echo "Missing command: ${rebuild_cmd}"
  exit 1
fi

run sudo "${rebuild_cmd}" switch --flake "${flake_ref}"

echo "#########################################################################"
echo "#   Nix Update Complete"
