#!/bin/sh
set -eu

dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "Usage: nix-update [--dry-run]"
  exit 1
fi

run() {
  if [ "$dry_run" -eq 1 ]; then
    echo "+ $*"
  else
    "$@"
  fi
}

unset CDPATH
repo_command="$(dirname -- "$0")/nix-repo"
if [ ! -x "$repo_command" ]; then
  repo_command="nix-repo"
fi
repo_dir="$($repo_command)"
flake_dir="${repo_dir}"
current_user="$(id -un)"
target_command="$(dirname -- "$0")/nix-target"
if [ ! -x "$target_command" ]; then
  target_command="nix-target"
fi
target="$($target_command)"
apply_kind="${target%%:*}"
flake_attr="${target#*:}"

echo "#########################################################################"
echo "#   Nix Update"
echo "#   Repo: ${repo_dir}"
echo "#   User: ${current_user}"
echo "#   Flake Dir: ${flake_dir}"
echo "#   Attr: ${flake_attr}"

cd "${flake_dir}"
run nix flake update

if [ "$dry_run" -eq 1 ]; then
  run nix flake check --all-systems --no-build --no-write-lock-file
else
  echo "#########################################################################"
  echo "#   Validate Updated Lock"
  nix flake check --all-systems --no-build --no-write-lock-file
fi

case "${apply_kind}" in
  nixos)
    if ! command -v nixos-rebuild >/dev/null 2>&1; then
      echo "Missing command: nixos-rebuild"
      exit 1
    fi
    run sudo nixos-rebuild switch --flake "${flake_dir}#${flake_attr}"
    ;;
  darwin)
    if ! command -v darwin-rebuild >/dev/null 2>&1; then
      echo "Missing command: darwin-rebuild"
      exit 1
    fi
    run sudo darwin-rebuild switch --flake "${flake_dir}#${flake_attr}"
    ;;
  home-manager)
    run env NIX_CONFIG="experimental-features = nix-command flakes" \
      nix run "${flake_dir}#home-manager" -- switch --flake "${flake_dir}#${flake_attr}"
    ;;
  *)
    echo "Unsupported apply kind: ${apply_kind}"
    exit 1
    ;;
esac

echo "#########################################################################"
echo "#   Nix Update Complete"
