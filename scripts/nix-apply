#!/bin/sh
set -eu

dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "Usage: nix-apply [--dry-run]"
  exit 1
fi

run() {
  if [ "$dry_run" -eq 1 ]; then
    echo "+ $*"
  else
    "$@"
  fi
}

unset CDPATH
repo_command="$(dirname -- "$0")/nix-repo"
if [ ! -x "$repo_command" ]; then
  repo_command="nix-repo"
fi
repo_dir="$($repo_command)"
current_user="$(id -un)"
target_command="$(dirname -- "$0")/nix-target"
if [ ! -x "$target_command" ]; then
  target_command="nix-target"
fi
target="$($target_command)"
apply_kind="${target%%:*}"
flake_attr="${target#*:}"

echo "#########################################################################"
echo "#   Nix Apply"
echo "#   Repo: ${repo_dir}"
echo "#   User: ${current_user}"
echo "#   Attr: ${flake_attr}"

case "${apply_kind}" in
  nixos)
    run sudo nixos-rebuild switch --flake "${repo_dir}#${flake_attr}"
    ;;
  darwin)
    run sudo darwin-rebuild switch --flake "${repo_dir}#${flake_attr}"
    ;;
  home-manager)
    run env NIX_CONFIG="experimental-features = nix-command flakes" \
      nix run "${repo_dir}#home-manager" -- switch --flake "${repo_dir}#${flake_attr}"
    ;;
  *)
    echo "Unsupported apply kind: ${apply_kind}"
    exit 1
    ;;
esac

echo "#########################################################################"
echo "#   Nix Apply Complete"
