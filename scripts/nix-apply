#!/bin/sh
set -eu

dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "Usage: nix-apply [--dry-run]"
  exit 1
fi

run() {
  if [ "$dry_run" -eq 1 ]; then
    echo "+ $*"
  else
    "$@"
  fi
}

unset CDPATH
repo_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"
current_user="$(id -un)"
apply_kind=""
flake_attr=""

case "$(uname -s)" in
  Linux)
    if command -v nixos-rebuild >/dev/null 2>&1; then
      apply_kind="nixos"
      flake_attr="nixos"
    else
      apply_kind="home-manager"
      flake_attr="ubuntu-desktop"
    fi
    ;;
  Darwin)
    apply_kind="darwin"
    case "$current_user" in
      q)
        flake_attr="mac"
        ;;
      ppy)
        flake_attr="mac-work"
        ;;
      *)
        echo "Unsupported Darwin user: ${current_user}"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Unsupported OS: $(uname -s)"
    exit 1
    ;;
esac

echo "#########################################################################"
echo "#   Nix Apply"
echo "#   Repo: ${repo_dir}"
echo "#   User: ${current_user}"
echo "#   Attr: ${flake_attr}"

case "${apply_kind}" in
  nixos)
    run sudo nixos-rebuild switch --flake "${repo_dir}#${flake_attr}"
    ;;
  darwin)
    run sudo darwin-rebuild switch --flake "${repo_dir}#${flake_attr}"
    ;;
  home-manager)
    run env NIX_CONFIG="experimental-features = nix-command flakes" \
      nix run home-manager -- switch --flake "${repo_dir}#${flake_attr}"
    ;;
  *)
    echo "Unsupported apply kind: ${apply_kind}"
    exit 1
    ;;
esac

echo "#########################################################################"
echo "#   Nix Apply Complete"
